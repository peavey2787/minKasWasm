{
  "name": "@minkas/kinesis-sdk",
  "version": "0.1.0",
  "description": "High-level SDK for Kaspa + VRF: connect, transact, observe, and generate verifiable randomness without blockDAG knowledge.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && node build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "watch": "tsc --watch",
    "clean": "rimraf dist",

    "dev": "vite",
    "preview": "vite preview"
  },
  "keywords": [
    "kaspa",
    "blockchain",
    "vrf",
    "sdk",
    "wasm"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5",
    "vite": "^5.4.0"
  },
  "peerDependencies": {},
  "dependencies": {}
}