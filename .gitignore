#############################
# GLOBAL MONOREPO IGNORE
#############################

# Node modules at ANY depth
**/node_modules/

# Build outputs
**/dist/
**/build/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/out/
**/.output/
**/.vercel/
**/.turbo/

# Vite / React / Webpack
**/.vite/
**/.parcel-cache/
**/.cache/

# TypeScript
**/*.tsbuildinfo

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Environment files
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*.swo

# Lockfiles (optional — remove if you want to keep them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

#############################
# END
#############################
